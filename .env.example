# docket configuration — copy to `.env` and edit. Every field is DK_-prefixed
# and env-overridable (see docket/config.py). The dashboard's Settings page
# writes overrides to `.env.local`, which layers over `.env`.

# --- Engine (mettle, the only backend) ---------------------------------------
# One OpenAI-/v1 base serves chat (with per-token logprobs), embeddings,
# /v1/rerank and collection search. There is no separate embed/rerank endpoint,
# and no local fallback: an unreachable engine fails loudly.
# DK_BACKEND_URL=http://127.0.0.1:11434/v1

# Set the binary to let `dk serve` spawn mettled when nothing answers on the
# base URL and restart it on crash. Unset => docket only probes.
# DK_ENGINE_BINARY=/path/to/mettled
# DK_METTLE_CONFIG=/path/to/mettle/config.toml   # passed as METTLE_CONFIG
# DK_ENGINE_KEY=...                              # only if the engine enforces auth
# DK_ENGINE_STARTUP_WINDOW_S=900                 # first run downloads weights

# Phase coordination (residency contract D5): a 6 GB card can't keep
# embed+rerank and the chat generator resident together, so mettle ships two
# profiles and docket switches between them per phase (docket/phase.py),
# applied per engine call. Names must match engine_collection's pattern
# (alnum + . _ -, 1-128 chars, no leading dot); set EITHER to an empty string
# to disable switching entirely (a single-profile engine).
# DK_ENGINE_RETRIEVAL_PROFILE=retrieval          # embed + rerank
# DK_ENGINE_CHAT_PROFILE=chat                    # the chat generator
# DK_ENGINE_SWITCH_TIMEOUT_S=120                 # measured switch cost ~2s

# --- Models ------------------------------------------------------------------
# Ids are engine catalog aliases, or `role:<kind>` resolved from the engine's
# active profile. The default is the FinanceBench winner, the Qwen3.5-4B
# Opus-distill (82.0% full-RAG @ 10 chunks) -- the `chat` profile's only slot.
# DK_CHAT_MODEL=qwen35-4b-opus-distill
# DK_EMBED_MODEL=qwen3-embedding-0.6b:latest     # direct /v1/embeddings only; collections embed with the engine default
# DK_RERANK_MODEL=qwen3-reranker-0.6b:latest

# --- Retrieval ---------------------------------------------------------------
# DK_ENGINE_COLLECTION=docket
# DK_RETRIEVAL_MODE=hybrid     # dense | keyword | hybrid
# DK_RETRIEVAL_K=20            # candidates pulled before rerank
# DK_CONTEXT_CHUNKS=10         # top chunks fed to the model
